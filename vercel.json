{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "www.maxpergola.com"}],
      "destination": "https://maxpergola.com/:path*",
      "permanent": true
    },
    {"source": "/index.html", "destination": "/", "permanent": true},
    {"source": "/pergola-kits/index.html", "destination": "/pergola-kits/", "permanent": true},
    {"source": "/pergola-kits/louvered/index.html", "destination": "/pergola-kits/louvered/", "permanent": true},
    {"source": "/pergola-kits/freestanding/index.html", "destination": "/pergola-kits/freestanding/", "permanent": true},
    {"source": "/pergola-kits/attached/index.html", "destination": "/pergola-kits/attached/", "permanent": true},
    {"source": "/pergola-kits/deck/index.html", "destination": "/pergola-kits/deck/", "permanent": true},
    {"source": "/best-aluminum-pergola-kits/index.html", "destination": "/best-aluminum-pergola-kits/", "permanent": true},
    {"source": "/pergola-kits/standard/index.html", "destination": "/pergola-kits/standard/", "permanent": true},
    {"source": "/pergola-kits/pro/index.html", "destination": "/pergola-kits/pro/", "permanent": true},
    {"source": "/pergola-kits/max/index.html", "destination": "/pergola-kits/max/", "permanent": true},
    {"source": "/engineering/specifications/index.html", "destination": "/engineering/specifications/", "permanent": true},
    {"source": "/engineering-calculator/", "destination": "/pergola-calculator/", "permanent": true},
    {"source": "/engineering-calculator/index.html", "destination": "/pergola-calculator/", "permanent": true},
    {"source": "/pergola-calculator/index.html", "destination": "/pergola-calculator/", "permanent": true},
    {"source": "/warranty/index.html", "destination": "/warranty/", "permanent": true},
    {"source": "/request-quote/index.html", "destination": "/request-quote/", "permanent": true},
    {"source": "/crm/index.html", "destination": "/crm/", "permanent": true},
    {"source": "/pergola-lighting-ideas/index.html", "destination": "/pergola-lighting-ideas/", "permanent": true},
    {"source": "/pergola-installation/index.html", "destination": "/pergola-installation/", "permanent": true},
    {"source": "/pergola-cost/index.html", "destination": "/pergola-cost/", "permanent": true},
    {"source": "/diy-pergola/index.html", "destination": "/diy-pergola/", "permanent": true},
    {"source": "/backyard-pergola-ideas/index.html", "destination": "/backyard-pergola-ideas/", "permanent": true},
    {"source": "/pergola-vs-gazebo/index.html", "destination": "/pergola-vs-gazebo/", "permanent": true},
    {"source": "/partner-program/index.html", "destination": "/partner-program/", "permanent": true},
    {"source": "/privacy-policy/index.html", "destination": "/privacy-policy/", "permanent": true},
    {"source": "/terms-of-use/index.html", "destination": "/terms-of-use/", "permanent": true},
    {"source": "/shipping-returns/index.html", "destination": "/shipping-returns/", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Content-Language", "value": "en-US"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex"}
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex"}
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex"}
      ]
    },
    {
      "source": "/7728d1e43c48ba5d3a9c7d6411fb24fc.txt",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/404.html",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/privacy-policy/",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/terms-of-use/",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/shipping-returns/",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/warranty/",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/request-quote/",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]
    },
    {
      "source": "/crm/",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Cache-Control", "value": "private, no-store"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Cache-Control", "value": "private, no-store"}
      ]
    }
  ]
}
